{
  "name": "goldpainting",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "next build",
    "dev": "next dev",
    "check": "npm run lint && tsc --noEmit",
    "check:ts6": "npm run lint && tsc6 --noEmit",
    "start": "next start",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --fix --cache",
    "typecheck": "tsc --noEmit",
    "typecheck:ts6": "tsc6 --noEmit",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md,mdx}\" --cache",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md,mdx}\" --cache",
    "preview": "next build && next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@google/genai": "^2.21.0",
    "@t3-oss/env-nextjs": "^0.13.11",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "embla-carousel-react": "^8.6.0",
    "lucide-react": "^1.42.0",
    "next": "^16.3.4",
    "nodemailer": "^9.1.0",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-google-reviews": "^1.9.0",
    "react-icons": "^5.7.0",
    "react-medium-image-zoom": "^5.4.9",
    "shadcn": "^4.21.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "yet-another-react-lightbox": "^3.32.2",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@tsconfig/next": "^2.0.6",
    "@types/node": "^26.5.0",
    "@types/nodemailer": "^8.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@typescript/native": "npm:typescript@^7.0.2",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.10.0",
    "eslint-config-next": "^16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-drizzle": "^0.2.3",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "typescript-eslint": "^8.70.0"
  },
  "ct3aMetadata": {
    "initVersion": "7.40.0"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "0.28.0"
    },
    "postcss": "$postcss"
  },
  "packageManager": "npm@12.0.2"
}
